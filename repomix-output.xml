              type="button"
              onClick={handleSaveRename}
              disabled={!name.trim()}
              className="shrink-0 rounded-full bg-foreground px-4 py-2 text-sm font-medium text-background disabled:opacity-30"
            >
              Save
            </button>
          </div>
        )}
