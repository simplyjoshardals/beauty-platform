"use client";

import { useState, type KeyboardEvent } from "react";
import { XIcon, CheckIcon, PlusIcon } from "@phosphor-icons/react";
import { useSavedPosts } from "@/hooks/useSavedPosts";

type Props = {
  open: boolean;
  onClose: () => void;
